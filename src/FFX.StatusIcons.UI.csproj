<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional local path override. This file is excluded from Git. -->
  <Import Project="../Fahrenheit.local.props" Condition="Exists('../Fahrenheit.local.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>FFX.StatusIcons.UI</AssemblyName>
    <Version>0.1.0</Version>
    <FahrenheitRoot Condition="'$(FahrenheitRoot)' == ''">$(MSBuildThisFileDirectory)../external/fahrenheit</FahrenheitRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(FahrenheitRoot)/src/core/Fahrenheit.csproj"
                      Private="false" ExcludeAssets="runtime;native" />
    <None Update="FFX.StatusIcons.UI.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckFahrenheitSource" BeforeTargets="PrepareForBuild;CollectPackageReferences">
    <Error Condition="!Exists('$(FahrenheitRoot)/src/core/Fahrenheit.csproj')"
           Text="Fahrenheit source not found. Set FahrenheitRoot in Fahrenheit.local.props or pass -p:FahrenheitRoot=PATH. See README.md." />
  </Target>
</Project>
